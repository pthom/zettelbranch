{
  "manifest_version": 3,
  "name": "Zettelbranch",
  "version": "0.2.1",
  "description": "Branch claude.ai conversations into new chats named with tree addresses (oulipo/1a). No permissions. Network: claude.ai's own API only, all in api.js.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["tree.js", "conversation.js", "prompt.js", "api.js", "menu.js", "branch.js", "ui.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "zettelbranch@pthom.github.io",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/pthom/zettelbranch/main/updates.json",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
